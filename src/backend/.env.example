# Copia este archivo como .env y completa tus valores. El archivo .env no se sube al repositorio.
ENVIRONMENT=development

# Base de datos (por defecto SQLite local: sqlite:///./app.db)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecologistica

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL del frontend, usada en el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173
# Orígenes CORS permitidos, separados por comas. En staging/producción todos deben usar HTTPS.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Correo saliente. Si SMTP_HOST está vacío, los correos se muestran en el log del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ecologistica.pe
